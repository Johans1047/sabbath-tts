    "narrative":  {
                      "northStar":  "La Guía de Estudio, a todo color",
                      "overview":  "A day of the Guía is a printed page you can also hear. The page is warm printing paper set in Literata; the audio lives inside it. One saturated week colour floods the title band edge to edge and then recedes into small marks. Seven day tabs hang from the band like guide dividers; a listened day is stamped. Night is the same page on warm dark paper with the week colour dimmed.",
                      "keyCharacteristics":  [
                                                 "Colour is carried by data (the week), not by chrome.",
                                                 "Flat, tonal depth; a hairline rule is the main separator.",
                                                 "Bricolage Grotesque names and operates, Literata is the text read and heard.",
                                                 "Pill for actions, soft 8/14px corners for content, 12px-topped tabs for dividers."
                                             ],
                      "rules":  [
                                    {
                                        "section":  "colors",
                                        "body":  "One week colour fills the band edge to edge and nowhere else at full strength; below the band it appears only as small marks or as a tint of paper.",
                                        "name":  "The One Flood Rule"
                                    },
                                    {
                                        "section":  "colors",
                                        "body":  "In dark mode the band is the week hue mixed 66% toward band-shade; light mode is 100%. Marks on dark paper are lightened with a mix toward ink instead of using the raw hue.",
                                        "name":  "The Night Dimming Rule"
                                    },
                                    {
                                        "section":  "colors",
                                        "body":  "Week colour is a data rule: lesson number modulo 7 selects the hue. Do not hand-pick a hue for a surface.",
                                        "name":  "The Hue-By-Lesson Rule"
                                    },
                                    {
                                        "section":  "colors",
                                        "body":  "Every ring hue was audited numerically against on-band cream at 4.5:1 or better (research/contrast.mjs); the dark 66% band mix was audited the same way.",
                                        "name":  "The Contrast-Audited Ring Rule"
                                    },
                                    {
                                        "section":  "typography",
                                        "body":  "Literata is only for text that is read and heard; Bricolage is for everything that names or operates.",
                                        "name":  "The Two Voices Rule"
                                    },
                                    {
                                        "section":  "typography",
                                        "body":  "Labels are sentence case at normal tracking; hierarchy comes from weight and size.",
                                        "name":  "The No-Uppercase Rule"
                                    },
                                    {
                                        "section":  "elevation",
                                        "body":  "Reading content has no shadow; \"you are here\" is tint plus a 1.5px inset outline, never a side stripe or a lift.",
                                        "name":  "The Paper Stays Flat Rule"
                                    }
                                ],
                      "dos":  [
                                  "Do let the week colour flood the band edge to edge and appear below it only as small marks or a paper tint.",
                                  "Do set lesson text in Literata and everything operable in Bricolage Grotesque.",
                                  "Do keep reading surfaces flat; show the spoken position with the tinted, outlined segment.",
                                  "Do use pills for actions, 8/14px corners for content, and a 3px ink rule to open each section.",
                                  "Do dim the band to the 66% mix in night and lighten dark-paper marks toward ink.",
                                  "Do run any new hue or band mix through research/contrast.mjs (4.5:1 against on-band)."
                              ],
                      "donts":  [
                                    "Don\u0027t build an album-art, cover-image, or dark media-player surface; the audio belongs inside the page.",
                                    "Don\u0027t use side-stripe borders or box shadows on reading content to mark state.",
                                    "Don\u0027t show more than one week colour per screen or pick a hue by hand; the lesson number decides.",
                                    "Don\u0027t use uppercase, tracked labels in the interface.",
                                    "Don\u0027t treat the stamp\u0027s turbulence filter or the cool active fill in an ink-blue week as house rules; they are carries of this build."
                                ]
                  }
}