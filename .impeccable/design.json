                           "css":  ".ds-tabs{display:grid;grid-template-columns:repeat(3,72px);gap:3px;padding:16px 8px 0;background:var(--hue,#0e6a64)}.ds-tab{display:grid;justify-items:center;align-content:end;gap:1px;min-height:60px;padding:8px 0;border:1px solid transparent;border-bottom:0;border-radius:12px 12px 0 0;background:transparent;color:#fff7e8;font-family:\"Bricolage Grotesque\",sans-serif;cursor:pointer}.ds-tab b{font:700 1.25rem/1 \"Bricolage Grotesque\",sans-serif}.ds-tab span{font:500 .8125rem/1 \"Bricolage Grotesque\",sans-serif;opacity:.85}.ds-tab:hover{background:rgb(255 247 232/.14)}.ds-tab[aria-selected=true]{background:#f3eee4;color:#1f1c17;border-color:rgb(255 247 232/.24)}.ds-tab:focus-visible{outline:2px solid #fff7e8;outline-offset:2px}"
